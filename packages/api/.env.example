DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meal_planner
PORT=3001
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Optional: Redis connection for the socket.io adapter (multi-replica realtime).
# Leave unset for local dev and single-instance deploys — the realtime server
# falls back to the in-memory adapter. Set this when running multiple API
# replicas so realtime events fan out across all pods.
# REDIS_URL=redis://localhost:6379

