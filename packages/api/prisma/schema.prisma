generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Family {
  id               String            @id @default(uuid())
  name             String
  timezone         String            @default("UTC")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          FamilyMember[]
  meals            Meal[]
  weekPlans        WeekPlan[]
  agentCredentials AgentCredential[]
  tags             Tag[]
  imageAssets      ImageAsset[]
  recipeCollections RecipeCollection[]
  planningTemplates PlanningTemplate[]
  groceryCategories GroceryCategory[]
  pantryStaples     PantryStaple[]
}

model User {
  id          String           @id @default(uuid())
  email       String           @unique
  name        String
  avatarUrl   String?
  googleId    String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships FamilyMember[]
  suggestions MealSuggestion[]
}

model FamilyMember {
  id       String @id @default(uuid())
  role     Role   @default(CHILD)
  family   Family @relation(fields: [familyId], references: [id])
  familyId String
  user     User   @relation(fields: [userId], references: [id])
  userId   String

  @@unique([familyId, userId])
}

enum Role {
  PARENT
  CHILD
}

model Meal {
  id                   String           @id @default(uuid())
  name                 String
  description          String?
  imageUrl             String?
  placeholderKind      MealPlaceholderKind?
  difficulty           Difficulty?
  prepTimeMinutes      Int?
  cookTimeMinutes      Int?
  servings             Int?
  sourceUrl            String?
  notes                String?
  favorite             Boolean          @default(false)
  rating               Int?
  family               Family           @relation(fields: [familyId], references: [id])
  familyId             String
  ingredients          MealIngredient[]
  suggestions          MealSuggestion[]
  tags                 MealTag[]
  instructions         MealInstruction[]
  imageAssets          ImageAsset[]
  collections          MealRecipeCollection[]
  planningTemplateEntries PlanningTemplateEntry[]
  slots                MealSlot[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([familyId, placeholderKind])
  @@index([familyId, name])
  @@index([familyId, difficulty])
  @@index([familyId, createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Meal_name_trgm_idx", type: Gin)
}

enum MealPlaceholderKind {
  FREE_DAY
  LEFTOVERS
  TAKEOUT
  DINING_OUT
  TRAVEL
  SKIP
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model MealIngredient {
  id       String  @id @default(uuid())
  name     String
  quantity String?
  unit     String?
  category String?
  /// Dense, 0-based row order within a meal (matches MealInstruction.position),
  /// backfilled from pre-existing insertion order and maintained on write from
  /// the input array index. The tabular ("Grid") recipe view is order-sensitive
  /// — instruction spans reference ingredient rows by this position — so a
  /// stable durable order is required; Prisma insertion order alone is not a
  /// promise (tabular recipe view).
  position   Int     @default(0)
  /// AUTHORED LAYOUT OVERRIDE — never derived-and-persisted. An optional group
  /// pill label ("Shrimp", "Breading", …) for the tabular view. `null` does NOT
  /// mean "authored as empty": it means *derive this at read time* (from
  /// contiguous runs of `category`). The derived grouping is display-only,
  /// recomputed on every read, and is NEVER written back. Do not backfill or
  /// cache derived group labels here — persisted derived state goes stale (see
  /// the grocery-provenance staleness lesson in decisions.md). Only the Phase-2
  /// layout editor writes this column.
  groupLabel String?
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId   String
}

/// Ordered preparation steps for a meal (issue #100). Instructions are an
/// ordered child of Meal — family-scoped THROUGH `Meal.familyId` (no direct
/// Family relation, mirroring MealIngredient) and cascade-deleted with the
/// meal. `position` is a dense, 0-based ordering key; the service layer uses
/// replace-all-on-update semantics, deleting all rows for a meal and recreating
/// them from the input array index, so no `@@unique([mealId, position])` is
/// needed. Steps are plain text for P2 (ingredient references deferred per #92).
model MealInstruction {
  id           String  @id @default(uuid())
  meal         Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId       String
  position     Int
  text         String
  timerMinutes Int?
  /// Tabular-view band classification. `SETUP` renders as a full-width leading
  /// band, `FINISH` as a trailing note, `PROCESS` (the default) as a spanning
  /// process column. Defaulted, so every existing step is a plain PROCESS step
  /// until the Phase-2 editor says otherwise; the derived value (from a verb
  /// allow-list at read time) is display-only and never written here.
  kind      InstructionKind @default(PROCESS)
  /// AUTHORED LAYOUT OVERRIDE — never derived-and-persisted. An optional "sub"
  /// detail line (e.g. a temperature/time fragment) for the tabular view. `null`
  /// does NOT mean "authored as empty": it means *derive this at read time* from
  /// the step text. The derived value is display-only, recomputed on every read,
  /// and is NEVER written back. Do not backfill or cache it here. Only the
  /// Phase-2 layout editor writes this column.
  subLabel  String?
  /// AUTHORED LAYOUT OVERRIDE — never derived-and-persisted. The process-column
  /// index this step occupies (cascade ordering) in the tabular view. `null`
  /// does NOT mean "authored as empty": it means *derive this at read time*. The
  /// derived layout is display-only, recomputed on every read, and is NEVER
  /// written back. Do not backfill or cache it here. Only the Phase-2 layout
  /// editor writes this column.
  column    Int?
  /// AUTHORED LAYOUT OVERRIDE — never derived-and-persisted, and the source of
  /// truth for provenance: a meal is "authored" IFF any instruction has a
  /// non-null `spanFrom` (there is deliberately no stored `isDerived` boolean —
  /// a cached provenance flag is exactly the state that goes stale). This is the
  /// inclusive start of the ingredient-row range (references
  /// `MealIngredient.position`) that this step combines. `null` does NOT mean
  /// "authored as empty": it means *derive this at read time* from step text.
  /// The derived span is display-only, recomputed on every read, and is NEVER
  /// written back — do not backfill or cache derived spans here; persisted
  /// derived state goes stale (see the grocery-provenance staleness lesson in
  /// decisions.md). Only the Phase-2 layout editor writes this column.
  spanFrom  Int?
  /// AUTHORED LAYOUT OVERRIDE — never derived-and-persisted. The inclusive end
  /// of the ingredient-row range (references `MealIngredient.position`) this
  /// step combines. `null` does NOT mean "authored as empty": it means *derive
  /// this at read time* from step text. The derived span is display-only,
  /// recomputed on every read, and is NEVER written back — do not backfill or
  /// cache derived spans here (persisted derived state goes stale; see
  /// decisions.md). Only the Phase-2 layout editor writes this column.
  spanTo    Int?

  @@index([mealId])
}

/// Tabular-recipe band classification for a `MealInstruction` (tabular recipe
/// view). `PROCESS` (the default) is a normal spanning process step; `SETUP` is
/// a full-width leading band (preheat/line/boil…); `FINISH` is a trailing note
/// (cool/rest/serve/garnish). The value stored here is the AUTHORED
/// classification; when unauthored, the read path derives an effective kind at
/// read time (display-only, never persisted).
enum InstructionKind {
  SETUP
  PROCESS
  FINISH
}

/// Family-scoped, free-form tag taxonomy (issue #107). A tag belongs to exactly
/// one family and is case-insensitively unique within it: `nameNormalized`
/// (`lower(trim(name))`, computed in the service layer) is the uniqueness key,
/// while `name` preserves the original display casing. The Family relation is
/// `onDelete: Restrict` (a family with tags cannot be silently cascade-deleted),
/// mirroring the deliberate meal family-scoping pattern.
model Tag {
  id             String    @id @default(uuid())
  name           String
  nameNormalized String
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  familyId       String
  meals          MealTag[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([familyId, nameNormalized])
  @@index([familyId])
}

/// Family-scoped grocery aisle categories (issue #119). Unlike Tag
/// (which is FK-joined to meals), this model is an advisory *pick-list* layered
/// over the shared INGREDIENT_CATEGORIES defaults: `MealIngredient.category` and
/// `GroceryItem.category` remain free-form `String?` and are NOT foreign keys to
/// this table. Families add custom aisle names here; the effective list a client
/// offers is `INGREDIENT_CATEGORIES ∪ custom rows`. Same case-insensitive
/// per-family uniqueness and Restrict on the Family relation as Tag.
model GroceryCategory {
  id             String   @id @default(uuid())
  name           String
  nameNormalized String
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  familyId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([familyId, nameNormalized])
  @@index([familyId])
}

/// Explicit many-to-many join between Meal and Tag (mirrors MealIngredient's
/// explicit-relation style). Composite primary key prevents duplicate
/// assignments; `onDelete: Cascade` on BOTH foreign keys means deleting a meal
/// OR a tag cleans up its join rows automatically.
model MealTag {
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([mealId, tagId])
  @@index([tagId])
}

model WeekPlan {
  id        String    @id @default(uuid())
  weekStart DateTime
  family    Family    @relation(fields: [familyId], references: [id])
  familyId  String
  days      DayPlan[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([familyId, weekStart])
}

model DayPlan {
  id          String           @id @default(uuid())
  date        DateTime
  weekPlan    WeekPlan         @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  weekPlanId  String
  suggestions MealSuggestion[]

  @@unique([weekPlanId, date])
}

model MealSuggestion {
  id        String   @id @default(uuid())
  meal      Meal     @relation(fields: [mealId], references: [id])
  mealId    String
  dayPlan   DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  dayPlanId String
  suggestedBy User   @relation(fields: [userId], references: [id])
  userId    String
  approved  Boolean  @default(false)
  // Approver metadata. Approval is no longer actorless: when a suggestion is
  // approved we capture WHO approved it (a family member or an MCP agent
  // credential) and WHEN. `approvedByActorType` is "user" | "agent";
  // `approvedById` is the User.id or AgentCredential.id respectively. Left as
  // a plain string pair (not an FK) because the approver is polymorphic.
  approvedByActorType String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt DateTime @default(now())
  choices   SuggestionChoiceSnapshot[]

  @@index([mealId, approved])
}

model GroceryList {
  id        String        @id @default(uuid())
  weekStart DateTime
  familyId  String
  items     GroceryItem[]
  createdAt DateTime      @default(now())
}

enum GrocerySource {
  GENERATED
  MANUAL
}

model GroceryItem {
  id            String        @id @default(uuid())
  name          String
  quantity      String?
  unit          String?
  category      String?
  checked       Boolean       @default(false)
  sources       String[]      @default([])
  origin        GrocerySource @default(GENERATED)
  edited        Boolean       @default(false)
  sourceMealIds String[]      @default([])
  /// Weekday offsets (0=Monday .. 6=Sunday, matching PlanningTemplateEntry.dayOfWeek)
  /// of the meal-plan days this item's source meals fall on. Deduped and sorted
  /// Mon→Sun at generation time. Empty for MANUAL items.
  sourceDays    Int[]         @default([])
  groceryList   GroceryList   @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  groceryListId String
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  key       String    @unique
  familyId  String
  createdBy String
  expiresAt DateTime?
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

/// Scoped, least-privilege credential for MCP agents that read AND mutate
/// meal plans. Deliberately SEPARATE from the read-only Magic Mirror `ApiKey`
/// so a write-capable agent credential can never be conflated with a display
/// key. Only the SHA-256 `hashedKey` is stored; the raw key is returned once
/// at creation/rotation and never persisted or logged. `scopes` holds the
/// per-operation grants (`meal_plan:read` | `meal_plan:schedule` |
/// `meal_plan:approve`). A credential is family-scoped, revocable
/// (`revokedAt`) and expirable (`expiresAt`).
model AgentCredential {
  id        String          @id @default(uuid())
  name      String
  hashedKey String          @unique
  family    Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId  String
  scopes    String[]        @default([])
  createdBy String
  expiresAt DateTime?
  lastUsed  DateTime?
  revokedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  auditLogs AgentAuditLog[]

  @@index([familyId])
}

/// Append-only audit trail for every agent authorization decision. Records
/// who (credential), what family, what action, the target resource id(s), the
/// outcome (allowed | denied) and an optional reason. `credentialId` is a
/// nullable FK with onDelete: SetNull so audit history survives credential
/// rotation/revocation/deletion. `familyId` is a plain string (matching the
/// existing `GroceryList.familyId` style) so the log is never cascade-wiped.
model AgentAuditLog {
  id           String           @id @default(uuid())
  actorType    String
  credential   AgentCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  credentialId String?
  familyId     String
  action       String
  targetType   String?
  targetIds    String[]         @default([])
  outcome      String
  reason       String?
  createdAt    DateTime         @default(now())

  @@index([familyId])
  @@index([credentialId])
}

/// A binary image asset (photo) uploaded for a family, optionally associated
/// with a meal. Bytes live on the configured `ImageStorage` backend under a
/// family-scoped, opaque path — never served by raw filesystem path. The row
/// stores only validated metadata (MIME, extension, size) plus ownership.
/// `family` cascades on delete (an asset must not outlive its family); `meal`
/// is SetNull so deleting a meal releases the association without destroying
/// the family-owned asset. On-disk file GC on family delete is a future
/// concern — families are not deleted in current flows.
model ImageAsset {
  id          String   @id @default(uuid())
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId    String
  meal        Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
  mealId      String?
  contentType String
  extension   String
  byteSize    Int
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([familyId])
  @@index([mealId])
}

/// Family-scoped, curated recipe collection (issue #109) — a named list a meal
/// can belong to (e.g. "Weeknight Dinners", "Holiday Baking"). Deliberately a
/// DISTINCT model from Tag (curated lists, not free-form taxonomy) and
/// structurally mirrors it: case-insensitively unique within a family via
/// `nameNormalized` (`lower(trim(name))`, computed in the service layer) while
/// `name` preserves display casing. Adds an optional `description` (a curated
/// list carries a blurb; only the collection NAME round-trips through CSV). The
/// Family relation is `onDelete: Restrict`, mirroring Tag.
model RecipeCollection {
  id             String                 @id @default(uuid())
  name           String
  nameNormalized String
  description    String?
  family         Family                 @relation(fields: [familyId], references: [id], onDelete: Restrict)
  familyId       String
  meals          MealRecipeCollection[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([familyId, nameNormalized])
  @@index([familyId])
}

/// Explicit many-to-many join between Meal and RecipeCollection. Composite
/// primary key prevents duplicate memberships; `onDelete: Cascade` on BOTH
/// foreign keys means deleting a meal OR a collection cleans up its join rows
/// automatically (same dual-cascade semantics as MealTag).
model MealRecipeCollection {
  meal               Meal             @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId             String
  recipeCollection   RecipeCollection @relation(fields: [recipeCollectionId], references: [id], onDelete: Cascade)
  recipeCollectionId String

  @@id([mealId, recipeCollectionId])
  @@index([recipeCollectionId])
}

/// Reusable, family-scoped week planning template. A template is a named set of
/// (dayOfWeek -> meal) entries that can be APPLIED to any target week to produce
/// UNAPPROVED MealSuggestion rows (same approval workflow as repeatWeek /
/// scheduleMeal). Structurally mirrors RecipeCollection: case-insensitively
/// unique within a family via `nameNormalized` (`lower(trim(name))`, computed in
/// the service layer) while `name` preserves display casing. The Family relation
/// is `onDelete: Restrict`, mirroring RecipeCollection/Tag so family
/// deletion stays guarded consistently.
model PlanningTemplate {
  id             String                  @id @default(uuid())
  name           String
  nameNormalized String
  description    String?
  family         Family                  @relation(fields: [familyId], references: [id], onDelete: Restrict)
  familyId       String
  entries        PlanningTemplateEntry[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([familyId, nameNormalized])
  @@index([familyId])
}

/// Family-scoped managed pantry staples (issue #205). "Stock kitchen" items
/// (salt, spices, oil, ...) that a family keeps on hand and does not want mixed
/// into the active shopping list. A grocery item whose normalized name matches a
/// staple is auto-separated into a dedicated "Pantry Staples" section rather than
/// its aisle category — staple items are never deleted or pruned, only segmented.
/// `nameNormalized` uses the SAME normalization as grocery keys
/// (`normalizeIngredientName`) so matching against grocery item names is exact,
/// while `name` preserves display casing for the settings UI. Unlike Tag /
/// GroceryCategory (Restrict), the Family relation is `onDelete: Cascade`:
/// staples are pure settings data with no dependents, so deleting a family
/// cleans them up automatically.
model PantryStaple {
  id             String   @id @default(uuid())
  name           String
  nameNormalized String
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([familyId, nameNormalized])
  @@index([familyId])
}

/// A configurable choice point on a meal (e.g. "Protein", "Sauce"). Slots are
/// ordered (position) within the meal and owned exclusively by it — they
/// cascade-delete with the meal. All slots on a meal must be resolved to a
/// SuggestionChoiceSnapshot before a MealSuggestion can be approved (enforced
/// in the service layer; no redundant boolean is stored here). v1 is
/// single-choice and required; no defaults or multi-select.
model MealSlot {
  id        String           @id @default(uuid())
  meal      Meal             @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId    String
  /// Display label shown to the user, e.g. "Protein" or "Sauce".
  name      String
  /// Dense 0-based ordering within the meal, maintained at write time.
  position  Int              @default(0)
  options   MealSlotOption[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([mealId])
}

/// One selectable choice within a MealSlot. v1: single-choice, no defaults.
/// Options contribute additive ingredients only — they do not override the
/// meal's base ingredient list. At least one option per slot is required but
/// enforced in the service layer, not the DB schema.
model MealSlotOption {
  id          String                     @id @default(uuid())
  slot        MealSlot                   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  slotId      String
  /// Display label shown to the user, e.g. "Chicken" or "Tofu".
  name        String
  /// Dense 0-based ordering within the slot, maintained at write time.
  position    Int                        @default(0)
  ingredients MealSlotOptionIngredient[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([slotId])
}

/// Additive ingredient contributed by a MealSlotOption. Mirrors MealIngredient
/// field shape (name, quantity, unit, category, position) but belongs to an
/// option, not the base meal. Cascade-deleted with its option.
model MealSlotOptionIngredient {
  id       String         @id @default(uuid())
  option   MealSlotOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId String
  name     String
  quantity String?
  unit     String?
  category String?
  /// Dense 0-based row order within the option, matching the input array index.
  position Int            @default(0)

  @@index([optionId])
}

/// Immutable scheduling snapshot of the option chosen for one MealSlot when a
/// MealSuggestion was scheduled. Created at choice time, never mutated.
/// Stores display data (slotName, optionName) and additive ingredient data
/// independently of live MealSlot / MealSlotOption rows so that later recipe
/// edits cannot rewrite planning history. Source ids (slotId, optionId) are
/// retained as plain nullable strings — NOT foreign keys — so deleting or
/// editing a slot or option cannot cascade into or invalidate history rows.
/// Copying a week's suggestions copies these rows verbatim (same immutability
/// guarantee applies to the copy).
model SuggestionChoiceSnapshot {
  id           String                              @id @default(uuid())
  suggestion   MealSuggestion                      @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  suggestionId String
  /// Source traceability only — plain strings, no FK constraint. May be null
  /// if the originating slot or option has been deleted since scheduling.
  slotId       String?
  optionId     String?
  /// Captured display data — immutable after insert.
  slotName     String
  optionName   String
  ingredients  SuggestionChoiceIngredientSnapshot[]
  createdAt    DateTime                            @default(now())

  @@index([suggestionId])
}

/// Immutable snapshot of one additive ingredient within a
/// SuggestionChoiceSnapshot. Mirrors MealSlotOptionIngredient field shape.
/// Cascade-deleted with its parent snapshot (which cascade-deletes with the
/// MealSuggestion), so no orphan rows survive suggestion deletion.
model SuggestionChoiceIngredientSnapshot {
  id       String                   @id @default(uuid())
  choice   SuggestionChoiceSnapshot @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  choiceId String
  name     String
  quantity String?
  unit     String?
  category String?
  /// Dense 0-based row order within the snapshot, matching the source option's
  /// ingredient position at the time of scheduling.
  position Int                      @default(0)

  @@index([choiceId])
}

/// A single (dayOfWeek -> meal) slot within a PlanningTemplate. `dayOfWeek` is a
/// RELATIVE offset (0=Monday .. 6=Sunday), NOT a calendar date, so the template
/// is reusable across weeks. `onDelete: Cascade` on BOTH foreign keys: deleting
/// the template drops its entries, and deleting a meal silently removes the
/// entries that referenced it (same dual-cascade join semantics as
/// MealTag/MealRecipeCollection). This keeps the template valid and
/// ensures `apply` never dereferences a dangling meal.
model PlanningTemplateEntry {
  id         String           @id @default(uuid())
  template   PlanningTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  dayOfWeek  Int
  meal       Meal             @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId     String

  @@unique([templateId, dayOfWeek, mealId])
  @@index([templateId])
  @@index([mealId])
}
